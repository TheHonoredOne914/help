# Supabase Configuration (required for login + stable archive ownership)
# Copy Project URL + anon/public key from Supabase → Project Settings → API.
# Without these, auth is disabled and the backend scopes archives to local-dev-user.
# Never put the service_role key here.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: App URL (used for OAuth redirects)
VITE_APP_URL=http://localhost:5173

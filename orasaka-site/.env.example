# Server-only settings. Never prefix secrets with NEXT_PUBLIC_.

# public (default, also when unset): confirmed prices on the site. Web checkout is off.
# Purchases that work today go to the Telegram bot. The site button does not create an order.
# demo: isolated TEST fixtures, no backend calls. live: unverified backend stub — do not use it as the public site.
# Read at build time by Next.js.
SITE_MODE=public

# disabled (default) | mock (demo only, in-memory TEST checkout). Any other value is treated as disabled.
PAYMENTS_MODE=disabled
# YooKassa stays off until shop id, secret and YOOKASSA_MODE=test|live are all set on the server.
# Leave the values empty in git. Never prefix them with NEXT_PUBLIC_.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_MODE=
# Optional. Default is https://api.yookassa.ru/v3. Any other address is refused unless the local stand flag is set.
YOOKASSA_API_BASE=
# 1 allows http://127.0.0.1 or http://localhost as YOOKASSA_API_BASE, and only when ORASAKA_PROFILE=isolated.
# The public profile refuses to boot with this flag. Leave it empty. This is not the YooKassa test shop.
YOOKASSA_LOCAL_STAND=
ENABLE_YOOKASSA=false
ENABLE_CRYPTO=false
# Crypto Pay (@CryptoBot), USDT. Empty token keeps the method off. Do not prefix the token with NEXT_PUBLIC_.
# test is exactly https://testnet-pay.crypt.bot/api. live is exactly https://pay.crypt.bot/api.
# Any other address is refused. Charges still require the shared term gate.
# Invoices use fiat=RUB and accepted_assets=USDT for catalog prices 200/500/900/1600.
CRYPTOPAY_ENABLED=
CRYPTOPAY_API_TOKEN=
CRYPTOPAY_MODE=
CRYPTOPAY_API_BASE=
# 1 allows http://127.0.0.1 or http://localhost as CRYPTOPAY_API_BASE, and only when ORASAKA_PROFILE=isolated.
# The public profile refuses to boot with this flag. Leave it empty. This is not Crypto Pay testnet.
CRYPTOPAY_LOCAL_STAND=

# public (default, also when unset) is the only profile for the public VPS.
# It refuses to boot if MAIL_MODE=dev or VPN_MODE=double.
# isolated is for local `next start` only. Do not set it on the public VPS.
ORASAKA_PROFILE=public

# dev = local mailbox, and only when ORASAKA_PROFILE=isolated. smtp = real SMTP. Empty = mail is off.
MAIL_MODE=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
# 1 = implicit TLS. Otherwise port 465 is implicit TLS and every other port requires STARTTLS.
# Certificate verification stays on. Do not set SMTP_INSECURE on the public profile (it refuses to boot).
SMTP_SECURE=
# HMAC secret for email codes. At least 16 characters. Empty here.
ORASAKA_CODE_SECRET=
# HMAC secret for the isolated test double. Not a Telegram bot token. Empty here.
ORASAKA_DOUBLE_SECRET=
# Legacy Login Widget: both the bot token and the public username. Token alone does not turn the button on.
# Empty until the owner sets them on the server. The token is not sent to the browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Current Telegram OIDC (BotFather → Login Widget). These are not the bot API token.
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# Absolute path outside the release directory, shared by the site and `npm run fulfill`.
# Example: /var/lib/orasaka/site.sqlite
ORASAKA_DB_PATH=
# double = isolated test double. Empty = use VPN_BASE_URL when set, otherwise the adapter is unconfigured.
# Not Remnawave and not the live bot.
VPN_MODE=
# Proposed HTTP contract. Empty until a base URL and bearer token are set on the server.
# The local stand is not the live bot. See openapi/vpn-v1.yaml and BACKEND_HANDOFF.md.
VPN_BASE_URL=
VPN_API_TOKEN=
VPN_TIMEOUT_MS=
# Empty: the site does not charge (termsReady stays false). Public is blocked until a production rule is set.
# Production (any profile): calendar-months | fixed-day-blocks
#   calendar-months — add N calendar months from max(current end, grant time); day-of-month kept when possible.
#   fixed-day-blocks — add N × 30 days from max(current end, grant time).
# Isolated test only: test-30-day-blocks (public refuses to boot with it). Switching public→isolated is not a production unlock.
# No tax rates are invented here.
VPN_DURATION_RULE=
# 1 turns the site buy button on only together with shop id, secret, YOOKASSA_MODE,
# and a ready term policy (production rule above, or the isolated test rule).
# Keys alone, or the flag alone, leave the button off.
PAYMENTS_READY=
# Empty means https://oauth.telegram.org. Any other issuer is the contract stand and
# the public profile refuses to boot with it. Do not set a stand issuer on the VPS.
TELEGRAM_OIDC_ISSUER=

# Set to "test" to show TEST plan fixtures in demo mode. Leave empty to show «Тарифы уточняются».
DEMO_FIXTURES=

# Existing ORASAKA FastAPI base URL (https only; http allowed for localhost). Used only when SITE_MODE=live.
# The live client is a blocking stub until the API contract is agreed: it makes NO requests to this URL;
# set → `contract_unverified`, empty → `backend_not_configured`.
ORASAKA_API_URL=

# Public origin of the site, exactly scheme://host[:port] (e.g. https://orasaka.example). Used for payment return URLs
# and as the only Origin accepted for POST/DELETE. https required (http only for localhost/127.0.0.1/[::1]).
# Empty = local development only: mutations are accepted just from http://localhost|127.0.0.1|[::1] matching Host.
# An https SITE_ORIGIN forces the session cookie's Secure flag. A client X-Forwarded-Proto
# cannot drop it. Set TRUST_PROXY=1 only when nginx overwrites both forwarded headers.
# A non-Secure cookie is issued for loopback plain HTTP in demo, and in public when SITE_ORIGIN is empty or http.
# Live mode and any https SITE_ORIGIN stay Secure. TRUST_PROXY=1 keeps the cookie Secure.
SITE_ORIGIN=
# nginx in front of the app, app port not reachable from the internet:
#   proxy_set_header X-Forwarded-For $remote_addr;
# That replaces the client header. Do not use $proxy_add_x_forwarded_for.
# Empty ignores X-Forwarded-For. 1 reads it only when it is a single address.
# Any other value refuses to boot. A comma-separated list does not open a new rate-limit bucket.
TRUST_PROXY=

# Server-only settings. Never prefix secrets with NEXT_PUBLIC_.

# demo (default): isolated TEST fixtures, no backend calls. live: talks to ORASAKA_API_URL.
SITE_MODE=demo

# disabled (default) | mock (demo only, in-memory TEST checkout). Any other value is treated as disabled.
PAYMENTS_MODE=disabled
# Reserved flags: this build always treats them as false.
ENABLE_YOOKASSA=false
ENABLE_CRYPTO=false

# Set to "test" to show TEST plan fixtures in demo mode. Leave empty to show «Тарифы уточняются».
DEMO_FIXTURES=

# Existing ORASAKA FastAPI base URL (https only; http allowed for localhost). Used only when SITE_MODE=live.
ORASAKA_API_URL=
ORASAKA_API_TIMEOUT_MS=8000

# Public origin used to build absolute payment return URLs for providers (e.g. https://orasaka.example). Empty = relative URLs (demo).
SITE_ORIGIN=
